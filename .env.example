# --- KgweboOS environment ---
# Supabase (when the sync adapter is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments — PayPal (PayPal wallet + Visa/Mastercard via Card Fields)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=BAA0cnAMEPlE7x2eKZViIBux1-OzMicoUkJ3RvUHMe-YJrPqCUbIBFLrhv8VVPu9DQVfcZfqtu41cI06Sg
PAYPAL_CLIENT_SECRET=            # REQUIRED for card payments + server verification (PayPal Dashboard → Apps & Credentials)
PAYPAL_WEBHOOK_ID=               # PayPal Dashboard → Webhooks (subscribe to PAYMENT.CAPTURE.*)
PAYPAL_ENV=live                  # live | sandbox
NEXT_PUBLIC_PAYPAL_FX_RATE=13.4  # BWP per USD used to convert P47 → USD

# AI (optional; local assistant works without it)
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_BWP=500

# Analytics / monitoring
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

JOBS_CRON_SECRET=replace-with-a-long-random-secret

# Messaging providers (optional until provider accounts are approved)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSAGING_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

OPENAI_VISION_MODEL=gpt-4o-mini
